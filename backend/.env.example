# FastAPI application display name.
APP_NAME=InvestGuide Backend

# Public application version returned by health checks.
APP_VERSION=0.1.0-alpha

# Runtime environment name: development, test, staging, or production.
APP_ENV=development

# Enables FastAPI debug behavior in local development only.
APP_DEBUG=true

# Python logging level for backend services.
LOG_LEVEL=INFO

# Local Docker PostgreSQL database used by docker-compose.yml.
DATABASE_URL=postgresql+psycopg://investguide_user:investguide_password@localhost:5433/investguide

# Comma-separated origins or a JSON array string allowed by CORS middleware.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Internal news ingestion adapter mode. Keep DRY_RUN unless intentionally enabling persistence.
INGESTION_MODE=DRY_RUN

# JWT signing secret for local development only. Replace in deployed environments.
JWT_SECRET_KEY=investguide-development-secret-change-me

# JWT signing algorithm.
JWT_ALGORITHM=HS256

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

