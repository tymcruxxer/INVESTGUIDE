APP_NAME=InvestGuide Backend
APP_VERSION=0.1.0-alpha
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Local PostgreSQL example. Replace username/password/host/db with your own dev database values.
DATABASE_URL=postgresql+psycopg://investguide_user:investguide_password@localhost:5432/investguide_dev

# Comma-separated origins or a JSON array string.
CORS_ORIGINS=http://localhost:3000

# Internal news ingestion adapter mode. Use DRY_RUN unless intentionally writing normalized payloads.
INGESTION_MODE=DRY_RUN